# ==============================================================================
# Enterprise Ops Dashboard — Variáveis de Ambiente
# Copie este arquivo para .env.local para configurar a conexão com seu banco:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados & Persistência Relacional (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Se não configurado, a aplicação roda de forma resiliente com store relacional
# em memória para testes imediatos sem dependência externa obrigatória.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# ------------------------------------------------------------------------------
# 2. Configurações da Aplicação
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
